pockettts_coreml/oracle/fixtures/english_alba_seed42/*.safetensors
pockettts_coreml/oracle/fixtures/english_alba_seed42/*.wav
pockettts_coreml/oracle/fixtures/english_alba_seed42/*.model
pockettts_coreml/oracle/fixtures/english_alba_seed42/golden/
pockettts_coreml/oracle/fixtures/english_alba_seed42/metadata.json

